process {
  executor = 'slurm'
}

executor {
  name = 'local'
  queueSize = 60
}

singularity {
    enabled = true
    autoMounts = true
    cacheDir = '/vast/scratch/users/lee.sa/singularity_cache'
}

dag {
  overwrite = true
}

// needed to allow module binaries (for process RUN_SUMMARIZED_EXPERIMENT)
nextflow.enable.moduleBinaries = true