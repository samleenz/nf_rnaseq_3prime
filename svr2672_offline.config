profiles {
  offline {
    // disable any Docker pulls
    docker {
      enabled = false
    }
    // enable Singularity and point at your local cache
    singularity {
      enabled  = true
      cacheDir = '/data/containers/lee_s/'
      autoMounts = true
    }

  dag {
    overwrite = true
  }

  report {
    overwrite = true
  }

  // needed to allow module binaries (for process RUN_SUMMARIZED_EXPERIMENT)
  nextflow.enable.moduleBinaries = true

    // override each process’s container by name (or by label)
    process {
      // ------- LOCAL PROCESSES -------
      withName: RUN_FASTQC {
        // match your .sif filename
        container = "${singularity.cacheDir}/fastqc_0.11.9--0.sif"
      }
      withName: RUN_TRIM_READS_SE {
        container = "${singularity.cacheDir}/cutadapt_4.1--py310h1425a21_1.sif"
      }
      withName: RUN_STAR_ALIGN_SE {
        // match your .sif filename
        container = "${singularity.cacheDir}/star_2.7.10b--h9ee0642_0.sif"
      }
      withName: RUN_STAR_ALIGN_SE_2PASS {
        // match your .sif filename
        container = "${singularity.cacheDir}/star_2.7.10b--h9ee0642_0.sif"
      }
      withName: RUN_FEATURECOUNTS_SE {
        // match your .sif filename
        container = "${singularity.cacheDir}/subread_2.0.1--hed695b0_0.sif"
      }

      // ------- MODULE_DIR PROCESSES -------
    withName: RUN_MULTIQC {
        // match your .sif filename
        container = "${singularity.cacheDir}/multiqc_1.14--pyhdfd78af_0.sif"
      }
      withName: RUN_STAR_GENOME_GENERATE {
        // match your .sif filename
        container = "${singularity.cacheDir}/star_2.7.10b--h9ee0642_0.sif"
      }
      withName: RUN_SUMMARIZED_EXPERIMENT {
        // match your .sif filename
        container = "${singularity.cacheDir}/run_summarized_experiment_v1.1.sif"
      }
    }

  }
}
